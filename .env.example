# Optional NCBI E-utilities credentials (recommended for higher rate limits)
NCBI_EMAIL=your.email@example.com
NCBI_API_KEY=

# Required for evidence extraction CLI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional path for local evidence SQLite DB (default: ./data/ecd_research.db)
ECD_DB_PATH=
